@page "/dashboard"

@attribute [Authorize]

@using DuoRico.Pro.Components.Shared
@using DuoRico.Pro.Constants
@using Microsoft.AspNetCore.Authorization
@using System.Globalization
@using DuoRico.Pro.Models
@using DuoRico.Pro.Data
@using DuoRico.Pro.Helpers
@using Microsoft.AspNetCore.Identity

@inject ITransactionService TransactionService
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager

<PageTitle>Duo Rico Pro - Dashboard</PageTitle>

<PageHeader Title="Visão geral" Subtitle="@($"{MonthName} de {_selectedYear}")" Icon="@Icons.Material.Rounded.SpaceDashboard">
    <Actions>
        <PeriodSelector @bind-Month="_selectedMonth"
                        @bind-Year="_selectedYear"
                        IsLoading="_isLoading"
                        OnFilterChanged="LoadDashboardDataAsync" />
    </Actions>
</PageHeader>

@* RESUMO: saldo em destaque; receitas e despesas lado a lado *@
<MudGrid Spacing="3" Class="mb-6">
    <MudItem xs="12" md="4">
        <div class="kpi-card kpi-hero">
            <div class="d-flex align-center justify-space-between">
                <span class="kpi-label">Saldo do mês</span>
                <MudIcon Icon="@Icons.Material.Rounded.AccountBalanceWallet" />
            </div>
            @if (_isLoading)
            {
                <MudSkeleton Width="60%" Height="40px" Class="kpi-skeleton" />
            }
            else
            {
                <span class="kpi-value">@_summary.Balance.ToString("C", Culture)</span>
            }
            <span class="kpi-caption">@BalanceCaption</span>
        </div>
    </MudItem>

    <MudItem xs="6" md="4">
        <div class="kpi-card surface-card">
            <div class="d-flex align-center justify-space-between">
                <span class="kpi-label">Receitas</span>
                <span class="kpi-icon tonal-success"><MudIcon Icon="@Icons.Material.Rounded.TrendingUp" Size="Size.Small" /></span>
            </div>
            @if (_isLoading)
            {
                <MudSkeleton Width="70%" Height="32px" />
            }
            else
            {
                <span class="kpi-value">@_summary.TotalIncome.ToString("C", Culture)</span>
            }
            <a href="incomes" class="kpi-link">Ver receitas</a>
        </div>
    </MudItem>

    <MudItem xs="6" md="4">
        <div class="kpi-card surface-card">
            <div class="d-flex align-center justify-space-between">
                <span class="kpi-label">Despesas</span>
                <span class="kpi-icon tonal-error"><MudIcon Icon="@Icons.Material.Rounded.TrendingDown" Size="Size.Small" /></span>
            </div>
            @if (_isLoading)
            {
                <MudSkeleton Width="70%" Height="32px" />
            }
            else
            {
                <span class="kpi-value">@_summary.TotalExpense.ToString("C", Culture)</span>
            }
            <a href="expenses" class="kpi-link">Ver despesas</a>
        </div>
    </MudItem>
</MudGrid>

@* REGRA DOS 10% NO CARTÃO DE CRÉDITO *@
<CreditCardHealthWidget TotalIncome="_summary.TotalIncome" Transactions="_monthlyTransactions" />

@* ÚLTIMAS DESPESAS *@
<section class="surface-card" aria-labelledby="latest-expenses-title">
    <div class="section-header">
        <MudText Typo="Typo.h6" id="latest-expenses-title">Últimas despesas</MudText>
        <MudButton Href="expenses" Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" EndIcon="@Icons.Material.Rounded.ChevronRight">
            Ver todas
        </MudButton>
    </div>

    @if (_isLoading)
    {
        @for (int i = 0; i < 3; i++)
        {
            <div class="tx-row">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="40px" Height="40px" Class="rounded-lg" />
                <div class="tx-main">
                    <MudSkeleton Width="60%" />
                    <MudSkeleton Width="35%" />
                </div>
            </div>
        }
    }
    else if (!_latestExpenses.Any())
    {
        <div class="empty-state">
            <span class="empty-state-icon tonal-primary"><MudIcon Icon="@Icons.Material.Rounded.ReceiptLong" /></span>
            <MudText Typo="Typo.subtitle1">Nenhuma despesa em @MonthName</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">As despesas do mês aparecem aqui.</MudText>
        </div>
    }
    else
    {
        <div class="tx-list">
            @foreach (var expense in _latestExpenses)
            {
                <div class="tx-row" @key="expense.Id">
                    <span class="tx-icon tonal-error">
                        <MudIcon Icon="@CategoryConstants.GetIcon(expense.Category)" Size="Size.Small" />
                    </span>
                    <div class="tx-main">
                        <div class="tx-title">@expense.Description</div>
                        <div class="tx-meta">
                            @expense.Category
                            @if (expense.TotalInstallments > 1)
                            {
                                <span> · @expense.InstallmentNumber/@expense.TotalInstallments</span>
                            }
                        </div>
                    </div>
                    <div class="tx-side">
                        <span class="tx-amount">@expense.Amount.ToString("C", Culture)</span>
                        <StatusChip IsPaid="@expense.IsPaid" Type="TransactionType.Expense" />
                    </div>
                </div>
            }
        </div>
    }
</section>

@code {
    private static readonly CultureInfo Culture = CultureInfo.GetCultureInfo("pt-BR");

    private int _selectedMonth = DateTime.Now.AddMonths(1).Month;
    private int _selectedYear = DateTime.Now.AddMonths(1).Year;

    private Guid _currentCoupleId = Guid.Empty;
    private bool _isLoading = true;

    private TransactionSummaryDto _summary = new();

    // Lista Real de Despesas
    private List<TransactionDto> _latestExpenses = new();

    // Regra dos 10% no cartão de crédito
    private List<TransactionDto> _monthlyTransactions = new();

    private string MonthName => DateHelpers.GetMonthName(_selectedMonth);

    private string BalanceCaption => _summary.TotalIncome > 0
        ? $"{_summary.TotalExpense / _summary.TotalIncome:P0} da receita comprometida"
        : "Receitas menos despesas do mês";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            var appUser = await UserManager.GetUserAsync(user);

            if (appUser?.CoupleId != null)
            {
                _currentCoupleId = appUser.CoupleId.Value;
                await LoadDashboardDataAsync();
            }
        }

        // Usuário sem casal vinculado: não há o que carregar
        if (_currentCoupleId == Guid.Empty) _isLoading = false;
    }

    private async Task LoadDashboardDataAsync()
    {
        if (_currentCoupleId == Guid.Empty) return;

        _isLoading = true;

        try
        {
            // Busca as transações do casal no banco de dados para o mês selecionado
            var transactions = await TransactionService.GetCoupleTransactionsForPeriodAsync(_currentCoupleId, _selectedMonth, _selectedYear);

            // Calcula os totais com LINQ
            _summary.TotalIncome = transactions.Where(t => t.Type == TransactionType.Income).Sum(t => t.Amount);
            _summary.TotalExpense = transactions.Where(t => t.Type == TransactionType.Expense).Sum(t => t.Amount);

            // Últimas 5 despesas (ordem decrescente de criação)
            _latestExpenses = transactions
                .Where(t => t.Type == TransactionType.Expense)
                .OrderByDescending(t => t.CreatedAt)
                .Take(5)
                .ToList();

            // Busca os dados da regra dos 10% no cartão de créidito
            _monthlyTransactions = transactions;
        }
        finally
        {
            _isLoading = false;
        }
    }
}
