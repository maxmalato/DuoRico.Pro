@using Microsoft.AspNetCore.Identity
@using DuoRico.Pro.Data

@implements IDisposable

@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager

<MudNavMenu Rounded="true" Margin="Margin.Dense" Class="pa-2">
    <MudNavLink Href="/dashboard" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home" IconColor="Color.Inherit">
        <MudText Typo="Typo.subtitle1" Class="fw-bold">
            Início
        </MudText>
    </MudNavLink>

    <MudDivider DividerType="DividerType.Middle" />

    <MudNavLink Href="/incomes" Icon="@Icons.Material.Filled.ArrowUpward" IconColor="Color.Success">
        <MudText Typo="Typo.subtitle1" Color="Color.Success">
            Receitas
        </MudText>
    </MudNavLink>

    <MudNavLink Href="/expenses" Icon="@Icons.Material.Filled.ArrowDownward" IconColor="Color.Error">
        <MudText Typo="Typo.subtitle1" Color="Color.Error">
            Despesas
        </MudText>
    </MudNavLink>

    <AuthorizeView>
        <Authorized>
            <MudNavLink Href="Account/Manage" Icon="@Icons.Material.Filled.Person">
                <MudText>@context.User.Identity?.Name</MudText>
            </MudNavLink>
            <form action="Account/Logout" method="post">
                <AntiforgeryToken />
                    
                <input type="hidden" name="ReturnUrl" value="@currentUrl" />

                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Text" Color="Color.Error" Class="w-100 justify-start px-4 py-3" Style="text-transform: none; padding-left: 54px !important;">
                    <MudIcon Icon="@Icons.Material.Filled.Logout" Class="mr-4" />
                    <MudText Typo="Typo.body2" Style="font-weight: 700;">Sair</MudText>
                </MudButton>
            </form>
        </Authorized>

        <NotAuthorized>
            <MudNavLink Href="/register" Icon="@Icons.Material.Filled.PersonAdd">
                Registrar
            </MudNavLink>
            <MudNavLink Href="/login" Icon="@Icons.Material.Filled.Login">
                Entrar
            </MudNavLink>
        </NotAuthorized>
    </AuthorizeView>
</MudNavMenu>

@code {
    private string? currentUrl;
    
    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}