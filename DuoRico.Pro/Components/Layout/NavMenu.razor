@* Navegação principal (drawer em tablet/desktop). No mobile o equivalente é o BottomNav. *@
<MudNavMenu Rounded="true" Margin="Margin.Dense" Color="Color.Primary" Class="app-nav pa-3">
    <AuthorizeView>
        <Authorized>
            <MudText Typo="Typo.overline" Class="app-nav-section">Visão geral</MudText>
            <MudNavLink Href="dashboard" Match="NavLinkMatch.All" Icon="@Icons.Material.Rounded.SpaceDashboard">Início</MudNavLink>
            <MudNavLink Href="incomes" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Rounded.TrendingUp">Receitas</MudNavLink>
            <MudNavLink Href="expenses" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Rounded.TrendingDown">Despesas</MudNavLink>

            <MudText Typo="Typo.overline" Class="app-nav-section mt-4">Conta</MudText>
            <MudNavLink Href="Account/Manage" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Rounded.ManageAccounts">Minha conta</MudNavLink>
        </Authorized>

        <NotAuthorized>
            <MudNavLink Href="login" Icon="@Icons.Material.Rounded.Login">Entrar</MudNavLink>
            <MudNavLink Href="register" Icon="@Icons.Material.Rounded.PersonAdd">Criar conta</MudNavLink>
        </NotAuthorized>
    </AuthorizeView>
</MudNavMenu>
