@inherits LayoutComponentBase
@using DuoRico.Pro.Services

@inject ThemeService ThemeService

@* Páginas de autenticação são SSR estático: o tema vem do cookie (ver ThemeService), sem JS do MudBlazor *@
<MudThemeProvider Theme="@AppTheme.Default" IsDarkMode="@ThemeService.IsDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="auth-layout d-flex align-center justify-center">
    @Body
</div>

@* "Aguarde..." no envio e mostrar/ocultar senha (arquivo externo por causa do CSP) *@
<script src="@Assets["js/auth.js"]"></script>
