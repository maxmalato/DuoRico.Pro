@inherits LayoutComponentBase

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="d-flex align-center justify-center" style="background-color: #F4F6F8; min-height: 100vh;">
    @Body
</div>

<script>
    window.addEventListener('submit', function() {
        
        // Desativa o botão de submit e muda o texto
        var btn = document.querySelector('button[type="submit"]');
        if (btn) {
            btn.style.pointerEvents = 'none';
            btn.style.opacity = '0.8';
            btn.innerText = 'Aguarde...';
        }
        
        // Desativa os links de ação
        var links = document.getElementById('actionLinks');
        if (links) {
            links.style.pointerEvents = 'none';
            links.style.opacity = '0.5';
        }
    });
</script>

@code {
    private MudTheme DuoRicoTheme = new MudTheme()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#D4AF37",
            AppbarBackground = "#1E1E24",
            Background = "#F4F6F8"
        },
        LayoutProperties = new LayoutProperties()
        {
            DefaultBorderRadius = "12px"
        }
    };
}