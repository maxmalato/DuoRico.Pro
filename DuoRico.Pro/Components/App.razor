@using DuoRico.Pro.Security
@using DuoRico.Pro.Services

<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="@(IsDarkMode ? "#171A21" : "#FFFFFF")" />
    <base href="/" />
    <ResourcePreloader />
    @* Fonte declarada aqui (e não no app.css) para usar a URL com fingerprint do @Assets: o MapStaticAssets
       só manda cache imutável para ela, e o preload e o @font-face precisam apontar para a mesma URL *@
    <link rel="preload" as="font" type="font/woff2" href="@Assets["fonts/inter-latin.woff2"]" crossorigin />
    <style>
        @@font-face {
            font-family: 'Inter';
            font-style: normal;
            font-weight: 100 900; /* variable: um arquivo cobre todos os pesos */
            font-display: swap;
            src: url('@Assets["fonts/inter-latin.woff2"]') format('woff2');
            unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC,
                           U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193,
                           U+2212, U+2215, U+FEFF, U+FFFD;
        }

        /* Arial com as métricas da Inter: reduz o "pulo" do texto enquanto a Inter não carrega */
        @@font-face {
            font-family: 'Inter Fallback';
            src: local('Arial');
            size-adjust: 107%;
            ascent-override: 90%;
            descent-override: 22.5%;
            line-gap-override: 0%;
        }
    </style>
    <link rel="stylesheet" href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["DuoRico.Pro.styles.css"]" />
    @* Único script inline da página: liberado no CSP pelo nonce desta requisição (ver SecurityExtensions) *@
    <ImportMap nonce="@HttpContext.GetCspNonce()" />
    <link rel="icon" type="image/png" href="favicon.png" />
    @* Card de compartilhamento (WhatsApp, LinkedIn, Facebook, X): os robôs leem o HTML do SSR, sem JS.
       Igual para todas as rotas e só com dados públicos da marca: nada do usuário pode vazar para cá. *@
    <meta name="description" content="@SiteDescription" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Duo Rico Pro" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content="Duo Rico Pro" />
    <meta property="og:description" content="@SiteDescription" />
    <meta property="og:url" content="@BaseUrl" />
    <meta property="og:image" content="@($"{BaseUrl}og-image.png")" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Logo do Duo Rico Pro" />
    <meta name="twitter:card" content="summary_large_image" />
    <script src="@Assets["js/theme.js"]"></script>
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <Routes @rendermode="PageRenderMode" ThemePreference="@ThemePreference" IsDarkMode="@IsDarkMode" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private const string SiteDescription =
        "Controle financeiro para casais: receitas, despesas e reserva de emergência em um só lugar.";

    // As redes exigem URL absoluta; o esquema já chega como https via ForwardedHeaders (proxy do Render).
    // Caminho fixo da imagem (sem fingerprint do @Assets) para a URL não mudar a cada deploy e não invalidar o cache delas.
    private string BaseUrl =>
        $"{HttpContext.Request.Scheme}://{HttpContext.Request.Host}{HttpContext.Request.PathBase}/";

    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;

    // Tema lido dos cookies (ver wwwroot/js/theme.js) para a primeira renderização já sair no tema certo
    private string? ThemePreference => HttpContext.Request.Cookies[ThemeService.PreferenceCookie];

    private bool IsDarkMode => ThemeService.ResolveIsDarkMode(
        ThemePreference, HttpContext.Request.Cookies[ThemeService.SystemCookie]);
}
