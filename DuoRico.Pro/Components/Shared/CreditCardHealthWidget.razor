@using DuoRico.Pro.Models
@using System.Globalization

<section class="surface-card pa-4 pa-sm-5 mb-6" aria-labelledby="card-usage-title">
    <div class="d-flex flex-wrap align-center justify-space-between gap-3 mb-3">
        <div class="d-flex align-center gap-3">
            <span class="page-header-icon tonal-primary">
                <MudIcon Icon="@Icons.Material.Rounded.CreditCard" />
            </span>
            <div>
                <MudText Typo="Typo.h6" id="card-usage-title">Uso do cartão</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Limite seguro: 10% da receita do mês</MudText>
            </div>
        </div>

        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@_statusColor" Icon="@_statusIcon" Class="ma-0">
            @_statusLabel
        </MudChip>
    </div>

    <div class="d-flex align-baseline flex-wrap gap-1 mb-2">
        <span class="kpi-value">@_creditCardTotal.ToString("C", _culture)</span>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">de @_creditCardLimit.ToString("C", _culture)</MudText>
    </div>

    <MudProgressLinear Color="@_statusColor"
                       Value="@Math.Min(_progressBarValue, 100)"
                       Rounded="true"
                       Size="Size.Large"
                       Class="card-usage-bar"
                       aria-label="@($"{_progressBarValue:F0}% do limite seguro usado")" />

    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-2">
        @if (_creditCardLimit <= 0 && _creditCardTotal > 0)
        {
            @:Sem receita no mês para calcular o limite.
        }
        else if (_progressBarValue > 100)
        {
            @($"{_progressBarValue:F0}% do limite · {(_creditCardTotal - _creditCardLimit).ToString("C", _culture)} acima")
        }
        else
        {
            @($"{_progressBarValue:F0}% do limite · {(_creditCardLimit - _creditCardTotal).ToString("C", _culture)} disponíveis")
        }
    </MudText>
</section>

@code {

    // O que o componente recebe do mundo exterior
    [Parameter] public decimal TotalIncome { get; set; }
    [Parameter] public IEnumerable<TransactionDto> Transactions { get; set; } = new List<TransactionDto>();

    // Variáveis internas para cálculo
    private decimal _creditCardTotal = 0;
    private decimal _creditCardLimit = 0;
    private double _progressBarValue = 0;
    private Color _statusColor = Color.Success;
    private string _statusIcon = Icons.Material.Rounded.CheckCircle;
    private string _statusLabel = "";
    private CultureInfo _culture = CultureInfo.GetCultureInfo("pt-BR");

    // Sempre que o Dashboard passar dados novos, esse método recalcula tudo
    protected override void OnParametersSet()
    {
        _creditCardLimit = TotalIncome * 0.10m;

        // Todas as despesas de Cartão de crédito (parceladas ou à vista)
        _creditCardTotal = Transactions
            .Where(t => t.Type == TransactionType.Expense && t.Category == "Cartão de crédito")
            .Sum(t => t.Amount);

        if (TotalIncome > 0)
        {
            _progressBarValue = (double)(_creditCardTotal / _creditCardLimit) * 100;
        }
        else
        {
            _progressBarValue = _creditCardTotal > 0 ? 100 : 0;
        }

        (_statusColor, _statusIcon, _statusLabel) = _progressBarValue switch
        {
            <= 70 => (Color.Success, Icons.Material.Rounded.CheckCircle, "Tranquilo"),
            > 70 and <= 90 => (Color.Warning, Icons.Material.Rounded.WarningAmber, "Atenção"),
            > 90 and <= 100 => (Color.Error, Icons.Material.Rounded.Error, "No limite"),
            _ => (Color.Error, Icons.Material.Rounded.Error, "Acima do limite")
        };
    }

}
