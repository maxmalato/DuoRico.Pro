@using DuoRico.Pro.Models
@using System.Globalization

<MudCard Elevation="2" Class="pa-5 rounded-lg mb-8">
    <div class="d-flex flex-column flex-sm-row justify-space-between align-start align-sm-center mb-2 gap-2">
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.CreditScore" Color="Color.Primary" Size="Size.Large"/>
            <MudText Typo="Typo.h6" Style="font-weight: 700;">Uso do cartão</MudText>
        </div>

        <MudAvatar Color="@_statusColor" Size="Size.Small">
            <MudIcon Icon="@_statusIcon" Color="Color.Inherit" Size="Size.Small"/>
        </MudAvatar>
    </div>

    <MudText Typo="Typo.body2" Color="Color.Default" Class="mb-4">
        Seu limite seguro é de 10% da sua receita mensal.
    </MudText>

    @{
        var visualBarFill = Math.Min(_progressBarValue, 100);
    }

    <MudProgressLinear Color="@_statusColor" Value="@visualBarFill" Size="Size.Large" Class="rounded-lg"
                       Style="height: 24px;">
        <MudText Typo="Typo.subtitle2" Style="font-weight: 700; color: white">
            @_progressBarValue.ToString("F0")%
        </MudText>
    </MudProgressLinear>

    <div class="d-flex justify-space-between mt-2">
        <MudText Typo="Typo.caption" Color="Color.Dark" Style="font-weight: 600;">
            Total gasto: @_creditCardTotal.ToString("C", _culture)
        </MudText>
        <MudText Typo="Typo.caption" Color="Color.Default">
            Limite seguro: @_creditCardLimit.ToString("C", _culture)
        </MudText>
    </div>
</MudCard>

@code {

    // O que o componente recebe do mundo exterior
    [Parameter] public decimal TotalIncome { get; set; }
    [Parameter] public IEnumerable<TransactionDto> Transactions { get; set; } = new List<TransactionDto>();

    // Variáveis internas para cálculo
    private decimal _creditCardTotal = 0;
    private decimal _creditCardLimit = 0;
    private double _percentageUsed = 0;
    private double _progressBarValue = 0;
    private Color _statusColor = Color.Success;
    private string _statusIcon = Icons.Material.Filled.CheckCircle;
    private CultureInfo _culture = CultureInfo.GetCultureInfo("pt-BR");

    // Sempre que o Dashboard passar dados novos, esse método recalcula tudo
    protected override void OnParametersSet()
    {
        _creditCardLimit = TotalIncome * 0.10m;

        // Todas as despesas de Cartão de crédito (parceladas ou à vista)
        _creditCardTotal = Transactions
            .Where(t => t.Type == TransactionType.Expense && t.Category == "Cartão de crédito")
            .Sum(t => t.Amount);

        if (TotalIncome > 0)
        {
            _percentageUsed = (double)(_creditCardTotal / TotalIncome) * 100;
            _progressBarValue = (double)(_creditCardTotal / _creditCardLimit) * 100;
        }
        else
        {
            _percentageUsed = _creditCardTotal > 0 ? 100 : 0;
            _progressBarValue = _creditCardTotal > 0 ? 100 : 0;
        }

        (_statusColor, _statusIcon) = _progressBarValue switch
        {
            <= 70 => (Color.Success, Icons.Material.Filled.CheckCircle),
            > 70 and <= 90 => (Color.Warning, Icons.Material.Filled.WarningAmber),
            _ => (Color.Error, Icons.Material.Filled.Error)
        };
    }

}