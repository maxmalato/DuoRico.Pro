@using System.Globalization
@using DuoRico.Pro.Constants
@using DuoRico.Pro.Models
@using DuoRico.Pro.Data
@using DuoRico.Pro.Helpers
@using Microsoft.AspNetCore.Identity

@inject ITransactionService TransactionService
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject IDialogService DialogService
@inject IBrowserViewportService BrowserViewport
@inject ISnackbar Snackbar

<PageHeader Title="@PageTitle" Subtitle="@($"{DateHelpers.GetMonthName(_selectedMonth)} de {_selectedYear}")" Icon="@Icon" IconColor="@ThemeColor">
    <Actions>
        <PeriodSelector @bind-Month="_selectedMonth"
                        @bind-Year="_selectedYear"
                        IsLoading="_isLoading"
                        OnFilterChanged="LoadDataAsync" />
    </Actions>
</PageHeader>

@* RESUMO DO MÊS *@
<div class="summary-grid mb-4">
    <div class="summary-item surface-card">
        <span class="summary-label">Total</span>
        <span class="summary-value" style="color: var(--mud-palette-@ColorName)">@_totalAmount.ToString("C", _culture)</span>
    </div>
    <div class="summary-item surface-card">
        <span class="summary-label">@PaidLabel</span>
        <span class="summary-value">@_totalPaid.ToString("C", _culture)</span>
    </div>
    <div class="summary-item surface-card">
        <span class="summary-label">Pendente</span>
        <span class="summary-value">@_totalUnpaid.ToString("C", _culture)</span>
    </div>
</div>

@* BUSCA + NOVO *@
<div class="table-toolbar mb-4">
    <MudTextField T="string"
                  Value="@_searchString"
                  ValueChanged="OnSearchChanged"
                  Placeholder="Buscar por descrição ou categoria"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Rounded.Search"
                  Clearable="true"
                  Immediate="true"
                  DebounceInterval="250"
                  Variant="Variant.Outlined"
                  Margin="Margin.Dense"
                  Class="table-search"
                  aria-label="Buscar lançamentos" />

    <MudButton Variant="Variant.Filled"
               Color="@ThemeColor"
               StartIcon="@Icons.Material.Rounded.Add"
               Class="hide-xs"
               OnClick="OpenNewTransactionDialog">
        Nova @SingularName
    </MudButton>
</div>

<div class="surface-card table-card">
    @* Tablet/desktop: tabela *@
    <MudTable Items="@_filtered"
              T="TransactionDto"
              Breakpoint="Breakpoint.None"
              Hover="true"
              Loading="@_isLoading"
              LoadingProgressColor="@ThemeColor"
              Elevation="0"
              Class="tx-table hide-xs">
        <HeaderContent>
            <MudTh>Descrição</MudTh>
            <MudTh>Categoria</MudTh>
            <MudTh>Status</MudTh>
            <MudTh Style="text-align: right">Valor</MudTh>
            <MudTh Style="width: 56px"><span class="visually-hidden">Ações</span></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>
                <div class="tx-title">@context.Description</div>
                <div class="tx-meta">
                    @context.CreatedAt.ToString("dd/MM/yyyy")
                    @if (context.TotalInstallments > 1)
                    {
                        <span> · Parcela @context.InstallmentNumber/@context.TotalInstallments</span>
                    }
                </div>
            </MudTd>
            <MudTd>
                <div class="d-flex align-center gap-2">
                    <MudIcon Icon="@CategoryConstants.GetIcon(context.Category)" Size="Size.Small" Class="mud-text-secondary" />
                    @context.Category
                </div>
            </MudTd>
            <MudTd>
                <StatusChip IsPaid="@context.IsPaid" Type="@Type" Disabled="@(_togglingId == context.Id)"
                            OnClick="@(() => TogglePaymentStatusAsync(context))" />
            </MudTd>
            <MudTd Style="text-align: right">
                <span class="tx-amount" style="color: var(--mud-palette-@ColorName)">@context.Amount.ToString("C", _culture)</span>
            </MudTd>
            <MudTd>@RowActions(context)</MudTd>
        </RowTemplate>
        <NoRecordsContent>@EmptyState</NoRecordsContent>
        <LoadingContent><div class="pa-6 mud-text-secondary">Carregando…</div></LoadingContent>
    </MudTable>

    @* Mobile: lista compacta (2 linhas por lançamento) *@
    <div class="tx-list only-xs">
        @if (_isLoading && _filtered.Count == 0)
        {
            @for (int i = 0; i < 4; i++)
            {
                <div class="tx-row">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="40px" Height="40px" Class="rounded-lg" />
                    <div class="tx-main">
                        <MudSkeleton Width="70%" />
                        <MudSkeleton Width="45%" />
                    </div>
                </div>
            }
        }
        else if (_filtered.Count == 0)
        {
            @EmptyState
        }
        else
        {
            @foreach (var t in _filtered)
            {
                <div class="tx-row" @key="t.Id">
                    <span class="tx-icon tonal-@ColorName">
                        <MudIcon Icon="@CategoryConstants.GetIcon(t.Category)" Size="Size.Small" />
                    </span>
                    <div class="tx-main">
                        <div class="tx-title">@t.Description</div>
                        <div class="tx-meta">
                            @t.Category · @t.CreatedAt.ToString("dd/MM/yy")
                            @if (t.TotalInstallments > 1)
                            {
                                <span> · @t.InstallmentNumber/@t.TotalInstallments</span>
                            }
                        </div>
                    </div>
                    <div class="tx-side">
                        <span class="tx-amount" style="color: var(--mud-palette-@ColorName)">@t.Amount.ToString("C", _culture)</span>
                        <StatusChip IsPaid="@t.IsPaid" Type="@Type" Disabled="@(_togglingId == t.Id)"
                                    OnClick="@(() => TogglePaymentStatusAsync(t))" />
                    </div>
                    @RowActions(t)
                </div>
            }
        }
    </div>
</div>

@* Mobile: botão flutuante acima da navegação inferior *@
<MudFab Color="@ThemeColor"
        StartIcon="@Icons.Material.Rounded.Add"
        Class="mobile-fab only-xs"
        OnClick="OpenNewTransactionDialog"
        aria-label="@($"Nova {SingularName}")" />

@code {
    [Parameter] public TransactionType Type { get; set; }
    [Parameter] public Color ThemeColor { get; set; }
    [Parameter] public string PageTitle { get; set; } = "";
    [Parameter] public string Icon { get; set; } = "";

    private int _selectedMonth = DateTime.Now.AddMonths(1).Month;
    private int _selectedYear = DateTime.Now.AddMonths(1).Year;
    private string _currentUserId = "";
    private Guid _currentCoupleId = Guid.Empty;
    private bool _isLoading = true;
    private string _searchString = "";
    private Guid? _togglingId;
    private CultureInfo _culture = CultureInfo.GetCultureInfo("pt-BR");
    private List<TransactionDto> _transactions = new();
    private List<TransactionDto> _filtered = new();
    private decimal _totalAmount, _totalPaid, _totalUnpaid;

    private bool IsIncome => Type == TransactionType.Income;
    private string SingularName => IsIncome ? "receita" : "despesa";
    private string PaidLabel => IsIncome ? "Recebido" : "Pago";
    private string ColorName => ThemeColor.ToString().ToLowerInvariant();

    private RenderFragment EmptyState => @<div class="empty-state">
        <span class="empty-state-icon tonal-@ColorName"><MudIcon Icon="@Icon" /></span>
        @if (string.IsNullOrWhiteSpace(_searchString))
        {
            <MudText Typo="Typo.subtitle1">Nenhuma @SingularName em @DateHelpers.GetMonthName(_selectedMonth)</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">Adicione a primeira para acompanhar o mês.</MudText>
            <MudButton Variant="Variant.Text" Color="@ThemeColor" StartIcon="@Icons.Material.Rounded.Add" OnClick="OpenNewTransactionDialog">Nova @SingularName</MudButton>
        }
        else
        {
            <MudText Typo="Typo.subtitle1">Nada encontrado para "@_searchString"</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Tente outro termo de busca.</MudText>
        }
    </div>;

    private RenderFragment RowActions(TransactionDto t) => @<MudMenu Icon="@Icons.Material.Rounded.MoreVert"
                                                                     Size="Size.Small"
                                                                     Dense="true"
                                                                     AnchorOrigin="Origin.BottomRight"
                                                                     TransformOrigin="Origin.TopRight"
                                                                     AriaLabel="@($"Ações de {t.Description}")">
        <MudMenuItem Icon="@Icons.Material.Rounded.Edit" OnClick="@(() => OpenEditTransactionDialog(t))">Editar</MudMenuItem>
        <MudMenuItem Icon="@Icons.Material.Rounded.Delete" IconColor="Color.Error" OnClick="@(() => DeleteTransaction(t, false))">
            @(t.TotalInstallments > 1 ? "Excluir esta parcela" : "Excluir")
        </MudMenuItem>
        @if (t.TotalInstallments > 1)
        {
            <MudMenuItem Icon="@Icons.Material.Rounded.DeleteSweep" IconColor="Color.Error" OnClick="@(() => DeleteTransaction(t, true))">
                Excluir esta e as próximas
            </MudMenuItem>
        }
    </MudMenu>;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            var appUser = await UserManager.GetUserAsync(user);
            if (appUser != null)
            {
                _currentUserId = appUser.Id;
                _currentCoupleId = appUser.CoupleId ?? Guid.Empty;
                await LoadDataAsync();
            }
        }

        // Usuário sem casal vinculado: não há o que carregar
        if (_currentCoupleId == Guid.Empty) _isLoading = false;
    }

    private async Task LoadDataAsync()
    {
        if (_currentCoupleId == Guid.Empty) return;
        _isLoading = true;
        try
        {
            // O filtro por tipo e a ordenação (pendentes primeiro, depois mais recentes)
            // são resolvidos no banco; aqui a lista já chega pronta para exibição.
            _transactions = await TransactionService
                .GetCoupleTransactionsForPeriodAsync(_currentCoupleId, _selectedMonth, _selectedYear, Type);

            CalculateSummaries();
            ApplyFilter();
        }
        finally { _isLoading = false; StateHasChanged(); }
    }

    private void CalculateSummaries()
    {
        _totalAmount = _transactions.Sum(t => t.Amount);
        _totalPaid = _transactions.Where(t => t.IsPaid).Sum(t => t.Amount);
        _totalUnpaid = _totalAmount - _totalPaid;
    }

    private void OnSearchChanged(string? value)
    {
        _searchString = value ?? "";
        ApplyFilter();
    }

    // Filtra uma vez por busca/carga, em vez de a cada renderização
    private void ApplyFilter()
    {
        _filtered = string.IsNullOrWhiteSpace(_searchString)
            ? _transactions
            : _transactions
                .Where(t => t.Description.Contains(_searchString, StringComparison.OrdinalIgnoreCase)
                         || t.Category.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
                .ToList();
    }

    private async Task TogglePaymentStatusAsync(TransactionDto t)
    {
        if (_togglingId is not null) return;

        _togglingId = t.Id;
        t.IsPaid = !t.IsPaid;
        try
        {
            await TransactionService
                .UpdateTransactionAsync(new UpdateTransactionDto { Id = t.Id, IsPaid = t.IsPaid, Description = t.Description, Amount = t.Amount, Category = t.Category }, _currentCoupleId);

            await LoadDataAsync();

            Snackbar.Add("Status atualizado.", Severity.Success);
        }
        catch { t.IsPaid = !t.IsPaid; Snackbar.Add("Erro ao atualizar.", Severity.Error); }
        finally { _togglingId = null; }
    }

    // No celular o formulário abre em tela cheia
    private async Task<DialogOptions> GetDialogOptionsAsync()
    {
        var breakpoint = await BrowserViewport.GetCurrentBreakpointAsync();
        return new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            FullScreen = breakpoint == Breakpoint.Xs
        };
    }

    private async Task OpenNewTransactionDialog()
    {
        var parameters = new DialogParameters<TransactionFormDialog>
        {
            { x => x.Type, Type },
            { x => x.DefaultMonth, _selectedMonth },
            { x => x.DefaultYear, _selectedYear }
        };

        var dialog = await DialogService.ShowAsync<TransactionFormDialog>($"Nova {SingularName}", parameters, await GetDialogOptionsAsync());
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: CreateTransactionDto newTransaction })
        {
            try
            {
                // Forçamos o tipo correto mais uma vez por segurança
                newTransaction.Type = Type;

                var success = await TransactionService.CreateTransactionAsync(newTransaction, _currentUserId, _currentCoupleId);

                if (success)
                {
                    Snackbar.Add($"{(IsIncome ? "Receita" : "Despesa")} adicionada!", Severity.Success);
                    await LoadDataAsync();
                }
                else
                {
                    Snackbar.Add("Erro ao criar a transação. Verifique os dados.", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Ocorreu um erro inesperado: {ex.Message}", Severity.Error);
            }
        }
    }

    private async Task OpenEditTransactionDialog(TransactionDto t)
    {
        var parameters = new DialogParameters<TransactionFormDialog>
        {
            { x => x.Type, t.Type },
            {
                x => x.Existing, new UpdateTransactionDto
                {
                    Id = t.Id,
                    Description = t.Description,
                    Amount = t.Amount,
                    Category = t.Category,
                    IsPaid = t.IsPaid,
                    Type = t.Type
                }
            }
        };

        var dialog = await DialogService.ShowAsync<TransactionFormDialog>($"Editar {SingularName}", parameters, await GetDialogOptionsAsync());
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: UpdateTransactionDto updatedTransaction })
        {
            var success = await TransactionService.UpdateTransactionAsync(updatedTransaction, _currentCoupleId);

            if (success)
            {
                Snackbar.Add("Alterações salvas!", Severity.Success);
                await LoadDataAsync();
            }
            else
            {
                Snackbar.Add("Erro ao atualizar a transação", Severity.Error);
            }
        }
    }

    private async Task DeleteTransaction(TransactionDto t, bool deleteInstallments = false)
    {
        string message = deleteInstallments
            ? $"Tem certeza que deseja excluir a parcela {t.InstallmentNumber}/{t.TotalInstallments} e todas as seguintes de '{t.Description}'?"
            : $"Tem certeza que deseja excluir {(t.TotalInstallments > 1 ? "apenas esta parcela de" : "a transação")} '{t.Description}'?";

        bool? result = await DialogService.ShowMessageBoxAsync("Confirmar exclusão", message, yesText: "Sim, excluir", cancelText: "Cancelar");

        if (result == true)
        {
            bool success;

            if (deleteInstallments)
            {
                success = await TransactionService.DeleteInstallmentsFromAsync(t.Id, _currentCoupleId);
            }
            else
            {
                success = await TransactionService.DeleteTransactionAsync(t.Id, _currentCoupleId);
            }

            if (success)
            {
                Snackbar.Add("Exclusão realizada com sucesso!", Severity.Success);
                await LoadDataAsync();
            }
            else
            {
                Snackbar.Add("Erro ao excluir. Tente novamente.", Severity.Error);
            }
        }
    }
}
