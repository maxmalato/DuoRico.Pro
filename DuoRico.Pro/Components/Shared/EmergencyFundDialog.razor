@* Edição do valor da reserva de emergência do casal. Devolve o novo valor (decimal). *@
<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-3">
            <span class="page-header-icon tonal-primary">
                <MudIcon Icon="@Icons.Material.Rounded.Savings" />
            </span>
            <MudText Typo="Typo.h6">Reserva de emergência</MudText>
        </div>
    </TitleContent>

    <DialogContent>
        <MudForm @ref="_form">
            <MoneyField @bind-Value="_amount" Label="Valor da reserva" Variant="Variant.Outlined" AllowZero="true" />
            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-2">
                O valor vale para todos os meses e não entra no saldo, receitas ou despesas.
            </MudText>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text" Color="Color.Default">Cancelar</MudButton>
        <MudButton OnClick="Submit" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Check">
            Salvar
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public decimal Amount { get; set; }

    private MudForm _form = default!;
    private decimal _amount;

    protected override void OnInitialized() => _amount = Amount;

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;

        MudDialog.Close(DialogResult.Ok(_amount));
    }
}
