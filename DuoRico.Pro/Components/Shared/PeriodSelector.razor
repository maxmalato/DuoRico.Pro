@using DuoRico.Pro.Helpers

@* Navegador de período: ‹ Novembro 2026 ›. As setas trocam de mês; o rótulo abre um seletor de mês/ano. *@
<div class="period-selector surface-card" @onkeydown="OnKeyDownAsync">
    <MudIconButton Icon="@Icons.Material.Rounded.ChevronLeft"
                   Size="Size.Small"
                   Disabled="@IsLoading"
                   OnClick="@(() => ShiftAsync(-1))"
                   aria-label="Mês anterior" />

    @* MudBlazor 9: ativador customizado precisa abrir o menu pelo MenuContext; posição padrão
       (origens customizadas jogavam o popover para o canto e alargavam a página no mobile) *@
    <MudMenu @ref="_menu"
             Disabled="@IsLoading"
             Class="period-selector-menu"
             AriaLabel="Escolher mês">
        <ActivatorContent>
            <MudButton Variant="Variant.Text"
                       Color="Color.Default"
                       Disabled="@IsLoading"
                       EndIcon="@Icons.Material.Rounded.ExpandMore"
                       Class="period-selector-label"
                       OnClick="@(e => OpenPickerAsync(context, e))">
                @if (IsLoading)
                {
                    <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" Class="mr-2 period-selector-spinner" />
                }
                @DateHelpers.GetMonthName(Month) @Year
            </MudButton>
        </ActivatorContent>
        <ChildContent>
            <div class="period-picker" @onkeydown="OnKeyDownAsync">
                <div class="period-picker-year">
                    <MudIconButton Icon="@Icons.Material.Rounded.ChevronLeft" Size="Size.Small" OnClick="@(() => _pickerYear--)" aria-label="Ano anterior" />
                    <MudText Typo="Typo.subtitle2">@_pickerYear</MudText>
                    <MudIconButton Icon="@Icons.Material.Rounded.ChevronRight" Size="Size.Small" OnClick="@(() => _pickerYear++)" aria-label="Próximo ano" />
                </div>
                <div class="period-picker-grid">
                    @for (int i = 1; i <= 12; i++)
                    {
                        var month = i;
                        var selected = month == Month && _pickerYear == Year;
                        <MudButton Size="Size.Small"
                                   Variant="@(selected ? Variant.Filled : Variant.Text)"
                                   Color="@(selected ? Color.Primary : Color.Default)"
                                   OnClick="@(() => SelectAsync(month, _pickerYear))">
                            @DateHelpers.GetMonthName(month)[..3]
                        </MudButton>
                    }
                </div>
            </div>
        </ChildContent>
    </MudMenu>

    <MudIconButton Icon="@Icons.Material.Rounded.ChevronRight"
                   Size="Size.Small"
                   Disabled="@IsLoading"
                   OnClick="@(() => ShiftAsync(1))"
                   aria-label="Próximo mês" />
</div>

@code {
    // Recebe o Mês e avisa o Pai quando mudar
    [Parameter] public int Month { get; set; }
    [Parameter] public EventCallback<int> MonthChanged { get; set; }

    // Recebe o Ano e avisa o Pai quando mudar
    [Parameter] public int Year { get; set; }
    [Parameter] public EventCallback<int> YearChanged { get; set; }

    // Recebe o status de carregamento e a função para disparar a busca
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public EventCallback OnFilterChanged { get; set; }

    private MudMenu _menu = default!;
    private int _pickerYear;

    // A grade sempre abre no ano que está sendo exibido
    private Task OpenPickerAsync(MenuContext menu, MouseEventArgs e)
    {
        _pickerYear = Year;
        return menu.ToggleAsync(e);
    }

    // Com ativador customizado o MudMenu não trata o Esc; fecha a grade sem trocar o período
    private Task OnKeyDownAsync(KeyboardEventArgs e) =>
        e.Key == "Escape" ? _menu.CloseMenuAsync() : Task.CompletedTask;

    private Task ShiftAsync(int months)
    {
        var date = new DateTime(Year, Month, 1).AddMonths(months);
        return SelectAsync(date.Month, date.Year);
    }

    private async Task SelectAsync(int month, int year)
    {
        await _menu.CloseMenuAsync();
        if (month == Month && year == Year) return;

        Month = month;
        Year = year;
        await MonthChanged.InvokeAsync(month);
        await YearChanged.InvokeAsync(year);
        await OnFilterChanged.InvokeAsync();
    }
}
