@using DuoRico.Pro.Components.Account.Shared
@using DuoRico.Pro.Services

@inject ThemeService ThemeService

@* Páginas de conta (/Account/*) são SSR estático: componentes que dependem de interatividade
   (menu do usuário, troca de tema) consultam este valor para não renderizar controles mortos. *@
<CascadingValue Value="@(AssignedRenderMode is not null)" Name="InteractivePage" IsFixed="true">
<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
            <NotAuthorized>
                @if (context.User.Identity?.IsAuthenticated is not true)
                {
                    <RedirectToLogin />
                }
                else
                {
                    <MudText Typo="Typo.body1" Class="pa-6">
                        Você não tem permissão para acessar esta área.
                    </MudText>
                }
            </NotAuthorized>
            <Authorizing>
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" Class="ma-6" />
            </Authorizing>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>Não encontrado</PageTitle>
        @* Informamos o layout vazio aqui também! *@
        <LayoutView Layout="typeof(Layout.AuthLayout)">
            @* Substitua o texto antigo pela chamada do seu componente *@
            <DuoRico.Pro.Components.Pages.NotFound />
        </LayoutView>
    </NotFound>
</Router>
</CascadingValue>

@code {
    // Vêm do App.razor (cookies da requisição) e inicializam o tema desta página/circuito
    [Parameter] public string? ThemePreference { get; set; }
    [Parameter] public bool IsDarkMode { get; set; }

    protected override void OnInitialized()
    {
        ThemeService.Initialize(ThemePreference, IsDarkMode);
    }
}
