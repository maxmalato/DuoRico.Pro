@using System.Globalization
@using DuoRico.Pro.Constants
@using DuoRico.Pro.DTOs
@using DuoRico.Pro.Helpers
@using DuoRico.Pro.Models

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" , Model="@Model">
            <MudGrid>
                <MudItem xs="12">
                    <MudTextField @bind-Value="Model.Description" Label="Descrição*" For="@(() => Model.Description)" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="Model.Amount" Label="Valor*" For="@(() => Model.Amount)" Format="N2" Culture="@(new CultureInfo("pt-BR"))" Min="0.01m" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudSelect @bind-Value="Model.Category" For="@(() => Model.Category)" Label="Categoria*" Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (var categorie in Categories)
                        {
                            <MudSelectItem Value="@categorie">@categorie</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="4">
                    <MudSelect @bind-Value="Model.Month" Label="Mês" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                        @for (int i = 1; i <= 12; i++)
                        {
                            var month = i;
                            <MudSelectItem Value="@month">@DateHelpers.GetMonthName(month)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="4">
                    <MudSelect @bind-Value="Model.Year" Label="Ano" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                        @for (int i = 2025; i <= DateTime.Now.Year + 3; i++)
                        {
                            var year = i;
                            <MudSelectItem Value="@year">@year</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudSelect @bind-Value="Model.InstallmentNumber" Label="Nº de Parcelas" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                        @for (int i = 1; i <= 48; i++)
                        {
                            var installments = i;
                            <MudSelectItem Value="@installments">@installments</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" Class="d-flex align-center">
                    <MudCheckBox @bind-Value="Model.IsPaid" 
                    Label="@(Model.Type == Models.TransactionType.Income ? "Recebido" : "Pago")" 
                    Color="Color.Default" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Class="px-4" Variant="Variant.Outlined" Color="Color.Error">
            <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" Class="mr-1" />
            Cancelar
        </MudButton>
        <MudButton Variant="Variant.Filled" OnClick="Submit" Class="px-6" Color="Color.Primary">
            <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" Class="mr-1" />
            Criar
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public CreateTransactionDto Model { get; set; } = new();
    [Parameter] public TransactionType Type { get; set; }
    [Parameter] public Color ColorTheme { get; set; }
    [Parameter] public Guid CoupleId { get; set; } = Guid.Empty;
    
    private MudForm _form = null!;
    private IReadOnlyList<string> Categories => CategoryConstants.GetCategoriesByType(Type);

    protected override void OnInitialized()
    {
        Model.Type = Type;
        if (Model.Month == 0) Model.Month = DateTime.Now.AddMonths(1).Month;
        if (Model.Year == 0) Model.Year = DateTime.Now.AddMonths(1).Year;
        if (Model.InstallmentNumber == 0) Model.InstallmentNumber = 1;
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        await _form.ValidateAsync();
        if (_form.IsValid)
        {
            MudDialog.Close(DialogResult.Ok(Model));
        }
    }
}