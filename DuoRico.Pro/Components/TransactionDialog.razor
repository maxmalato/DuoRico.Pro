@using DuoRico.Pro.Models
@using DuoRico.Pro.DTOs
@using DuoRico.Pro.Constants
@using System.Globalization

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form", Model="@Model">
            <MudGrid>
                <MudItem xs="12">
                    <MudTextField @bind-Value="Model.Description" Label="Descrição*" For="@(() => Model.Description)" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                
                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="Model.Amount" Label="Valor*" For="@(() => Model.Amount)" Format="N2" Culture="@(new CultureInfo("pt-BR"))" Min="0.01m" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudSelect @bind-Value="Model.Category" For="@(() => Model.Category)" Label="Categoria*" Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (var categoria in Categories)
                        {
                            <MudSelectItem Value="@categoria">@categoria</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                
                <MudItem xs="12" sm="4">
                    <MudSelect @bind-Value="Model.Month" Label="Mês" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                        @for (int i = 1; i <= 12; i++)
                        {
                            var month = i;
                            var nameMonth = CultureInfo.GetCultureInfo("pt-BR").DateTimeFormat.GetMonthName(month);
                            var monthFirstLetterUpper = char.ToUpper(nameMonth[0]) + nameMonth.Substring(1);
                           
                            <MudSelectItem Value="@month">@monthFirstLetterUpper</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="4">
                    <MudSelect @bind-Value="Model.Year" Label="Ano" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                        @for (int i = 2025; i <= DateTime.Now.Year + 3; i++)
                        {
                            var year = i;
                            <MudSelectItem Value="@year">@year</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudSelect @bind-Value="Model.InstallmentNumber" Label="Nº de Parcelas" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                        @for (int i = 1; i <= 48; i++)
                        {
                            var installments = i;
                            <MudSelectItem Value="@installments">@installments</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                
                <MudItem xs="12" Class="d-flex align-center">
                    <MudCheckBox @bind-Value="Model.IsPaid" Label="Pago?" Color="Color.Default" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Class="px-4" Style="background-color: #6c757d; color: white; text-transform: none;">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" OnClick="Submit" Class="px-6" Style="background-color: #dc3545; color: white; text-transform: none;">Criar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    
    [Parameter] public CreateTransactionDto Model { get; set; } = new();

    private MudForm _form = null!;
    private IReadOnlyList<string> Categories => CategoryConstants.GetCategoriesByType(Model.Type);
    
    protected override void OnInitialized()
    {
        if (Model.Month == 0) Model.Month = DateTime.Now.Month;
        if (Model.Year == 0) Model.Year = DateTime.Now.Year;
        if (Model.InstallmentNumber == 0) Model.InstallmentNumber = 1;
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        await _form.ValidateAsync();
        if (_form.IsValid)
        {
            MudDialog.Close(DialogResult.Ok(Model));
        }
    }
}