@using Microsoft.AspNetCore.Identity
@using DuoRico.Pro.Data

@inject SignInManager<ApplicationUser> SignInManager

<MudNavMenu Rounded="true" Margin="Margin.Dense" Color="Color.Primary" Class="pa-2">

    <MudNavLink Href="Account/Manage" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Person">
        <MudText Typo="Typo.subtitle2" Style="font-weight: 600;">Perfil</MudText>
    </MudNavLink>

    <MudNavLink Href="Account/Manage/Email" Icon="@Icons.Material.Filled.Email">
        <MudText Typo="Typo.subtitle2" Style="font-weight: 600;">E-mail</MudText>
    </MudNavLink>

    <MudNavLink Href="Account/Manage/ChangePassword" Icon="@Icons.Material.Filled.Lock">
        <MudText Typo="Typo.subtitle2" Style="font-weight: 600;">Senha</MudText>
    </MudNavLink>

    @if (hasExternalLogins)
    {
        <MudNavLink Href="Account/Manage/ExternalLogins" Icon="@Icons.Material.Filled.Link">
            <MudText Typo="Typo.subtitle2" Style="font-weight: 600;">Logins externos</MudText>
        </MudNavLink>
    }

    <MudNavLink Href="Account/Manage/TwoFactorAuthentication" Icon="@Icons.Material.Filled.Security">
        <MudText Typo="Typo.subtitle2" Style="font-weight: 600;">Autenticação de dois fatores</MudText>
    </MudNavLink>

    <MudNavLink Href="Account/Manage/PersonalData" Icon="@Icons.Material.Filled.PrivacyTip">
        <MudText Typo="Typo.subtitle2" Style="font-weight: 600;">Dados pessoais</MudText>
    </MudNavLink>

</MudNavMenu>

@code {
    private bool hasExternalLogins;

    protected override async Task OnInitializedAsync()
    {
        hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
    }
}