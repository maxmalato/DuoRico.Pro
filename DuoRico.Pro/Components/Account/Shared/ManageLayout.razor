@inherits LayoutComponentBase
@layout DuoRico.Pro.Components.Layout.MainLayout

<PageHeader Title="Minha conta"
            Subtitle="Perfil, segurança e dados pessoais"
            Icon="@Icons.Material.Rounded.ManageAccounts" />

<MudGrid Spacing="4">
    @* Menu: vertical no desktop, abas roláveis no mobile/tablet (ver ManageNavMenu) *@
    <MudItem xs="12" md="3">
        <ManageNavMenu />
    </MudItem>

    <MudItem xs="12" md="9">
        <div class="surface-card pa-5 pa-sm-8">
            @Body
        </div>
    </MudItem>
</MudGrid>
