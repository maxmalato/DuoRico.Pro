@page "/Account/ForgotPassword"

@using System.ComponentModel.DataAnnotations
@using System.Text
@using System.Text.Encodings.Web
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using DuoRico.Pro.Data

@layout DuoRico.Pro.Components.Layout.AuthLayout

@inject UserManager<ApplicationUser> UserManager
@inject IEmailSender<ApplicationUser> EmailSender
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<ForgotPassword> Logger

<PageTitle>Esqueci minha senha - Duo Rico Pro</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8 mb-8">
    <MudPaper Elevation="3" Class="pa-8 rounded-lg" Style="border: 1px solid var(--mud-palette-lines-default);">

        <div class="d-flex flex-column align-center mb-6">
            <MudIcon Icon="@Icons.Material.Filled.LockReset" Color="Color.Primary" Size="Size.Large" Class="mb-3" Style="width: 64px; height: 64px;" />
            <MudText Typo="Typo.h5" Style="font-weight: 700;" Color="Color.Dark">Esqueci minha senha</MudText>
            <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Dark" Class="mt-2">
                Digite seu e-mail cadastrado e enviaremos um link de recuperação.
            </MudText>
        </div>

        <EditForm Model="Input" FormName="forgot-password" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator />

            <MudTextField @bind-Value="Input.Email"
                          For="@(() => Input.Email)"
                          Name="Input.Email"
                          Label="E-mail"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Class="mb-6" />

            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       Size="Size.Large"
                       Class="w-100 py-2 mb-4"
                       Style="font-weight: bold; border-radius: 4px;">
                Enviar link de redefinição
            </MudButton>

            <div class="d-flex justify-center">
                <MudLink Href="/login" Color="Color.Primary" Typo="Typo.body2" Style="font-weight: 600;">
                    Lembrei da senha! Voltar para o Login.
                </MudLink>
            </div>
        </EditForm>
    </MudPaper>
</MudContainer>

@code {
    [SupplyParameterFromForm(FormName = "forgot-password")]
    private InputModel Input { get; set; } = default!;

    protected override void OnInitialized()
    {
        Input ??= new();
    }

    private async Task OnValidSubmitAsync()
    {
        var user = await UserManager.FindByEmailAsync(Input.Email);

        if (user is not null && await UserManager.IsEmailConfirmedAsync(user))
        {
            try
            {
                var code = await UserManager.GeneratePasswordResetTokenAsync(user);
                code = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(code));
                var callbackUrl = NavigationManager.GetUriWithQueryParameters(
                    NavigationManager.ToAbsoluteUri("Account/ResetPassword").AbsoluteUri,
                    new Dictionary<string, object?> { ["code"] = code });

                await EmailSender.SendPasswordResetLinkAsync(user, Input.Email, HtmlEncoder.Default.Encode(callbackUrl));
            }
            catch (Exception ex)
            {
                // Uma falha de envio não pode virar 500 nem mudar a resposta visível:
                // qualquer diferença revelaria que a conta existe (enumeração de usuários).
                Logger.LogError(ex, "Falha ao enviar o link de redefinição de senha para o usuário {UserId}.", user.Id);
            }
        }

        // Resposta idêntica em todos os caminhos: conta inexistente, e-mail não
        // confirmado, envio bem-sucedido ou envio com falha.
        // Fica fora do try/catch de propósito: se BlazorDisableThrowNavigationException
        // for removido do .csproj, o catch amplo engoliria a NavigationException e
        // quebraria o redirect silenciosamente.
        RedirectManager.RedirectTo("Account/ForgotPasswordConfirmation");
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "O e-mail é obrigatório.")]
        [EmailAddress(ErrorMessage = "Formato de e-mail inválido.")]
        public string Email { get; set; } = "";
    }
}