@page "/Account/Manage/Disable2fa"

@using Microsoft.AspNetCore.Identity
@using DuoRico.Pro.Data

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<Disable2fa> Logger

<PageTitle>Desativar 2FA - Duo Rico Pro</PageTitle>

<MudText Typo="Typo.h5" Style="font-weight: 700;" Color="Color.Dark" Class="mb-6">Desativar Autenticação em Duas Etapas (2FA)</MudText>

<StatusMessage />

<MudAlert Severity="Severity.Warning" Class="mb-6" Elevation="1">
    <MudText Typo="Typo.subtitle2" Style="font-weight: 700;" Class="mb-1">
        Esta ação apenas desativa a verificação 2FA.
    </MudText>
    <MudText Typo="Typo.body2">
        Desativar o 2FA não apaga a chave que já está salva no seu aplicativo autenticador no celular. Se você deseja invalidar a chave antiga, você deve <MudLink Href="Account/Manage/ResetAuthenticator" Color="Color.Inherit" Underline="Underline.Always">redefinir a chave do autenticador</MudLink>.
    </MudText>
</MudAlert>

<form @formname="disable-2fa" @onsubmit="OnSubmitAsync" method="post">
    <AntiforgeryToken />
    <MudButton ButtonType="ButtonType.Submit"
               Variant="Variant.Filled"
               Color="Color.Error"
               Size="Size.Large"
               StartIcon="@Icons.Material.Filled.GppBad"
               Style="font-weight: bold; border-radius: 4px;">
        Desativar 2FA
    </MudButton>
</form>

@code {
    private ApplicationUser? user;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        if (HttpMethods.IsGet(HttpContext.Request.Method) && !await UserManager.GetTwoFactorEnabledAsync(user))
        {
            throw new InvalidOperationException("Não é possível desativar o 2FA pois ele não está habilitado no momento.");
        }
    }

    private async Task OnSubmitAsync()
    {
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        var disable2faResult = await UserManager.SetTwoFactorEnabledAsync(user, false);
        if (!disable2faResult.Succeeded)
        {
            throw new InvalidOperationException("Ocorreu um erro inesperado ao tentar desativar o 2FA.");
        }

        var userId = await UserManager.GetUserIdAsync(user);
        Logger.LogInformation("O usuário '{UserId}' desativou o 2FA.", userId);

        RedirectManager.RedirectToWithStatus(
                    "Account/Manage/TwoFactorAuthentication",
                    "A autenticação em duas etapas (2FA) foi desativada. Você pode reativá-la configurando um aplicativo autenticador novamente.",
                    HttpContext);
    }
}