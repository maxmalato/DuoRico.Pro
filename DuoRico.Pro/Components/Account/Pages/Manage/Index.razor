@page "/Account/Manage"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using DuoRico.Pro.Data

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager
@inject IServiceProvider ServiceProvider

<PageTitle>Perfil - Duo Rico Pro</PageTitle>

<MudText Typo="Typo.h5" Style="font-weight: 700;" Color="Color.Dark" Class="mb-6">Meu Perfil</MudText>

<StatusMessage />

<EditForm Model="Input" FormName="profile" OnValidSubmit="OnValidSubmitAsync" method="post">
    <DataAnnotationsValidator />
    <ValidationSummary class="text-danger mb-4" role="alert" />

    <MudGrid>
        <MudItem xs="12" sm="10" md="8">

            @* E-mail (Desabilitado) *@
            <MudTextField Value="@username"
                          Label="E-mail"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Disabled="true"
                          Class="mb-4" />

            @* Nome *@
            <MudTextField @bind-Value="Input.Name"
                          For="@(() => Input.Name)"
                          Name="Input.Name"
                          Label="Nome Completo"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Class="mb-4" />

            @* ID do casal *@
            <MudTextField @bind-Value="Input.CoupleId"
                          For="@(() => Input.CoupleId)"
                          Name="Input.CoupleId"
                          Label="ID do Casal (Copie o ID do seu parceiro para vincular)"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Class="mb-4" />

            @* Telefone *@
            <MudTextField @bind-Value="Input.PhoneNumber"
                          For="@(() => Input.PhoneNumber)"
                          Name="Input.PhoneNumber"
                          Label="Telefone"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Class="mb-6" />

            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       Size="Size.Large"
                       Class="w-100 py-2"
                       Style="font-weight: bold; border-radius: 4px;">
                Salvar Alterações
            </MudButton>

        </MudItem>
    </MudGrid>
</EditForm>

@code {
    private ApplicationUser? user;
    private string? username;
    private string? phoneNumber;
    private string? name;
    private Guid? coupleId;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "profile")]
    private InputModel Input { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();

        user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        username = await UserManager.GetUserNameAsync(user);
        phoneNumber = await UserManager.GetPhoneNumberAsync(user);
        coupleId = user.CoupleId;
        name = user.Name;

        Input.PhoneNumber ??= phoneNumber;
        Input.Name ??= name;
        Input.CoupleId ??= coupleId?.ToString();
    }

    private async Task OnValidSubmitAsync()
    {
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        bool hasChanges = false;

        // 1. Atualiza Telefone
        if (Input.PhoneNumber != phoneNumber)
        {
            var setPhoneResult = await UserManager.SetPhoneNumberAsync(user, Input.PhoneNumber);
            if (!setPhoneResult.Succeeded)
            {
                RedirectManager.RedirectToCurrentPageWithStatus("Erro: Falha ao atualizar o número de telefone.", HttpContext);
                return;
            }
            hasChanges = true;
        }

        // 2. Atualiza Nome
        if (Input.Name != name)
        {
            user.Name = Input.Name;
            var updateResult = await UserManager.UpdateAsync(user);

            if (!updateResult.Succeeded)
            {
                RedirectManager.RedirectToCurrentPageWithStatus("Erro: Falha ao atualizar o nome.", HttpContext);
                return;
            }
            hasChanges = true;
        }

        // 3. Atualiza ID do Casal
        if (Input.CoupleId != coupleId?.ToString())
        {
            if (!string.IsNullOrWhiteSpace(Input.CoupleId) && Guid.TryParse(Input.CoupleId, out Guid newCoupleId))
            {
                var partnerExists = await UserManager.Users.AnyAsync(u => u.CoupleId == newCoupleId && u.Id != user.Id);

                if (!partnerExists)
                {
                    RedirectManager.RedirectToCurrentPageWithStatus("Erro: Nenhum parceiro encontrado com este ID.", HttpContext);
                    return;
                }

                user.CoupleId = newCoupleId;
                var updateResult = await UserManager.UpdateAsync(user);

                if (!updateResult.Succeeded)
                {
                    RedirectManager.RedirectToCurrentPageWithStatus("Erro: Falha ao vincular o ID do casal.", HttpContext);
                    return;
                }

                hasChanges = true;
            }
            else
            {
                RedirectManager.RedirectToCurrentPageWithStatus("Erro: O formato do ID do casal é inválido.", HttpContext);
                return;
            }
        }

        // 4. Finalização
        if (hasChanges)
        {
            await SignInManager.RefreshSignInAsync(user);
            RedirectManager.RedirectToCurrentPageWithStatus("Seu perfil foi atualizado com sucesso!", HttpContext);
        }
        else
        {
            RedirectManager.RedirectToCurrentPageWithStatus("Nenhuma alteração foi feita.", HttpContext);
        }
    }

    private sealed class InputModel
    {
        [Phone(ErrorMessage = "Número de telefone inválido.")]
        [Display(Name = "Telefone")]
        public string? PhoneNumber { get; set; }

        [Required(ErrorMessage = "O nome é obrigatório.")]
        [Display(Name = "Nome")]
        public string? Name { get; set; }

        [Display(Name = "ID do Casal")]
        public string? CoupleId { get; set; }
    }
}