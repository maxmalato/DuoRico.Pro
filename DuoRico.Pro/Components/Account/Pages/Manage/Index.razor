@page "/Account/Manage"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using DuoRico.Pro.Data

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager
@inject IServiceProvider ServiceProvider

<PageTitle>Perfil - Duo Rico Pro</PageTitle>

<MudText Typo="Typo.h5" Color="Color.Dark" Class="mb-6">Meu Perfil</MudText>

<StatusMessage />

<EditForm Model="Input" FormName="profile" OnValidSubmit="OnValidSubmitAsync" method="post">
    <DataAnnotationsValidator />

    <MudGrid>
        <MudItem xs="12" sm="10" md="8">

            @* E-mail (Desabilitado) *@
            <MudTextField Value="@username"
                          Label="E-mail"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Disabled="true"
                          Class="mb-4" />

            @* Nome *@
            <MudTextField @bind-Value="Input.Name"
                          For="@(() => Input.Name)"
                          name="Input.Name"
                          Label="Nome Completo"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Class="mb-4" />

            @* Telefone *@
            <MudTextField @bind-Value="Input.PhoneNumber"
                          For="@(() => Input.PhoneNumber)"
                          name="Input.PhoneNumber"
                          Label="Telefone"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Class="mb-6" />

            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       Size="Size.Large"
                       Class="mud-width-full py-2"
                      >
                Salvar Alterações
            </MudButton>

        </MudItem>
    </MudGrid>
</EditForm>

@code {
    private ApplicationUser? user;
    private string? username;
    private string? phoneNumber;
    private string? name;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "profile")]
    private InputModel Input { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();

        user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        username = await UserManager.GetUserNameAsync(user);
        phoneNumber = await UserManager.GetPhoneNumberAsync(user);
        name = user.Name;

        Input.PhoneNumber ??= phoneNumber;
        Input.Name ??= name;
    }

    private async Task OnValidSubmitAsync()
    {
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        bool hasChanges = false;

        // 1. Atualiza Telefone
        if (Input.PhoneNumber != phoneNumber)
        {
            var setPhoneResult = await UserManager.SetPhoneNumberAsync(user, Input.PhoneNumber);
            if (!setPhoneResult.Succeeded)
            {
                RedirectManager.RedirectToCurrentPageWithStatus("Erro: Falha ao atualizar o número de telefone.", HttpContext);
                return;
            }
            hasChanges = true;
        }

        // 2. Atualiza Nome
        if (Input.Name != name)
        {
            user.Name = Input.Name;
            var updateResult = await UserManager.UpdateAsync(user);

            if (!updateResult.Succeeded)
            {
                RedirectManager.RedirectToCurrentPageWithStatus("Erro: Falha ao atualizar o nome.", HttpContext);
                return;
            }
            hasChanges = true;
        }

        // O vínculo de casal não é editável aqui: só por convite, em Minha conta > Casal (ver CoupleService)

        // 3. Finalização
        if (hasChanges)
        {
            await SignInManager.RefreshSignInAsync(user);
            RedirectManager.RedirectToCurrentPageWithStatus("Seu perfil foi atualizado com sucesso!", HttpContext);
        }
        else
        {
            RedirectManager.RedirectToCurrentPageWithStatus("Nenhuma alteração foi feita.", HttpContext);
        }
    }

    private sealed class InputModel
    {
        [Phone(ErrorMessage = "Número de telefone inválido.")]
        [Display(Name = "Telefone")]
        public string? PhoneNumber { get; set; }

        [Required(ErrorMessage = "O nome é obrigatório.")]
        [Display(Name = "Nome")]
        public string? Name { get; set; }
    }
}