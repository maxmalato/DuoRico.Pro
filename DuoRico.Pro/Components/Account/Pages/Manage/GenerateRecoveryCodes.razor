@page "/Account/Manage/GenerateRecoveryCodes"

@using Microsoft.AspNetCore.Identity
@using DuoRico.Pro.Data

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<GenerateRecoveryCodes> Logger

<PageTitle>Gerar códigos de recuperação - Duo Rico Pro</PageTitle>

@if (recoveryCodes is not null)
{
    <ShowRecoveryCodes RecoveryCodes="recoveryCodes.ToArray()" StatusMessage="@message" />
}
else
{
    <MudText Typo="Typo.h5" Style="font-weight: 700;" Color="Color.Dark" Class="mb-6">Gerar Códigos de Recuperação</MudText>

    <MudAlert Severity="Severity.Warning" Class="mb-6" Elevation="1">
        <MudText Typo="Typo.subtitle2" Style="font-weight: 700;" Class="mb-1">Guarde esses códigos em um local seguro.</MudText>
        <MudText Typo="Typo.body2" Class="mb-2">
            Se você perder seu dispositivo e não tiver os códigos de recuperação, você <strong>perderá o acesso à sua conta</strong>.
        </MudText>
        <MudText Typo="Typo.body2">
            Gerar novos códigos não altera a chave do seu aplicativo autenticador. Se você deseja alterar a chave, vá para <MudLink Href="Account/Manage/ResetAuthenticator" Color="Color.Inherit" Underline="Underline.Always">Redefinir Autenticador</MudLink>.
        </MudText>
    </MudAlert>

    <form @formname="generate-recovery-codes" @onsubmit="OnSubmitAsync" method="post">
        <AntiforgeryToken />
        <MudButton ButtonType="ButtonType.Submit"
                   Variant="Variant.Filled"
                   Color="Color.Error"
                   Size="Size.Large"
                   StartIcon="@Icons.Material.Filled.Autorenew"
                   Style="font-weight: bold; border-radius: 4px;">
            Gerar Novos Códigos
        </MudButton>
    </form>
}

@code {
    private string? message;
    private ApplicationUser? user;
    private IEnumerable<string>? recoveryCodes;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        var isTwoFactorEnabled = await UserManager.GetTwoFactorEnabledAsync(user);
        if (!isTwoFactorEnabled)
        {
            throw new InvalidOperationException("Não é possível gerar códigos de recuperação pois a autenticação 2FA não está ativada.");
        }
    }

    private async Task OnSubmitAsync()
    {
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        var userId = await UserManager.GetUserIdAsync(user);
        recoveryCodes = await UserManager.GenerateNewTwoFactorRecoveryCodesAsync(user, 10);
        message = "Você gerou novos códigos de recuperação com sucesso.";

        Logger.LogInformation("O usuário '{UserId}' gerou novos códigos de recuperação 2FA.", userId);
    }
}