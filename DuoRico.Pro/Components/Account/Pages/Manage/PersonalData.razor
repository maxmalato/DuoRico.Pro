@page "/Account/Manage/PersonalData"

@using Microsoft.AspNetCore.Identity
@using DuoRico.Pro.Data

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Dados Pessoais - Duo Rico Pro</PageTitle>

<MudText Typo="Typo.h5" Color="Color.Dark" Class="mb-6">Dados Pessoais</MudText>

<StatusMessage />

<MudGrid>
    <MudItem xs="12" sm="10" md="8">
        <MudAlert Severity="Severity.Warning" Class="mb-6" Elevation="0">
            <MudText Typo="Typo.subtitle2" Class="mb-1">Atenção: Ação irreversível.</MudText>
            <MudText Typo="Typo.body2">
                Sua conta contém dados pessoais que você nos forneceu. A exclusão desta conta removerá permanentemente o seu acesso ao sistema.
            </MudText>
        </MudAlert>

        <MudButton Href="Account/Manage/DeletePersonalData"
                   Variant="Variant.Filled"
                   Color="Color.Error"
                   Size="Size.Large"
                   StartIcon="@Icons.Material.Filled.DeleteForever"
                  >
            Excluir minha conta
        </MudButton>
    </MudItem>
</MudGrid>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
        }
    }
}