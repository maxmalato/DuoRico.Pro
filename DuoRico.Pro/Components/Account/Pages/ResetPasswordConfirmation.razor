@page "/Account/ResetPasswordConfirmation"

@layout DuoRico.Pro.Components.Layout.AuthLayout

<PageTitle>Senha Redefinida - Duo Rico Pro</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8 mb-8">
    <MudPaper Elevation="3" Class="pa-8 rounded-lg text-center" Style="border: 1px solid var(--mud-palette-lines-default);">
        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Large" Class="mb-4" Style="width: 64px; height: 64px;" />

        <MudText Typo="Typo.h5" Style="font-weight: 700;" Color="Color.Dark" Class="mb-2">Senha redefinida com sucesso!</MudText>

        <MudText Typo="Typo.body1" Class="mb-6">
            Sua senha foi alterada. Agora você já pode acessar o sistema com as suas novas credenciais.
        </MudText>

        <MudButton Href="/login" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large" Style="font-weight: bold;">
            Ir para o Login
        </MudButton>
    </MudPaper>
</MudContainer>