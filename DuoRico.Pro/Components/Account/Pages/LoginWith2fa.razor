@page "/Account/LoginWith2fa"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using DuoRico.Pro.Data

@layout DuoRico.Pro.Components.Layout.AuthLayout

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<LoginWith2fa> Logger

<PageTitle>Autenticação 2FA - Duo Rico Pro</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8 mb-8">
    <MudPaper Elevation="3" Class="pa-8 rounded-lg" Style="border: 1px solid var(--mud-palette-lines-default);">

        <div class="d-flex flex-column align-center mb-6">
            <MudIcon Icon="@Icons.Material.Filled.Security" Color="Color.Primary" Size="Size.Large" Class="mb-3" Style="width: 64px; height: 64px;" />
            <MudText Typo="Typo.h5" Style="font-weight: 700;" Color="Color.Dark" Align="Align.Center">Autenticação em duas etapas</MudText>
            <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-2">
                Seu login está protegido. Digite o código do seu aplicativo autenticador abaixo.
            </MudText>
        </div>

        <StatusMessage Message="@message" />

        <EditForm Model="Input" FormName="login-with-2fa" OnValidSubmit="OnValidSubmitAsync" method="post">
            <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
            <input type="hidden" name="RememberMe" value="@RememberMe" />

            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger mb-4" role="alert" />

            <MudTextField @bind-Value="Input.TwoFactorCode"
                          For="@(() => Input.TwoFactorCode)"
                          Name="Input.TwoFactorCode"
                          Label="Código de Autenticação"
                          Placeholder="123456"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Class="mb-4" />

            <MudCheckBox @bind-Value="Input.RememberMachine"
                         For="@(() => Input.RememberMachine)"
                         Name="Input.RememberMachine"
                         Label="Lembrar deste dispositivo"
                         Color="Color.Primary"
                         Class="mb-6" />

            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       Size="Size.Large"
                       Class="w-100 py-2 mb-4"
                       Style="font-weight: bold; border-radius: 4px;">
                Entrar
            </MudButton>

            <MudButton Href="/"
                       Variant="Variant.Outlined"
                       Color="Color.Dark"
                       Size="Size.Large"
                       Class="w-100 py-2 mb-6"
                       Style="font-weight: bold; border-radius: 4px">
                Voltar para o login
            </MudButton>

            <div class="d-flex justify-center text-center">
                <MudText Typo="Typo.body2">
                    Não tem acesso ao celular? <br />
                    <MudLink Href="@($"Account/LoginWithRecoveryCode?ReturnUrl={ReturnUrl}")" Color="Color.Primary" Underline="Underline.Always" Style="font-weight: 600;">
                        Faça login com um código de recuperação
                    </MudLink>
                </MudText>
            </div>
        </EditForm>
    </MudPaper>
</MudContainer>

@code {
    private string? message;
    private ApplicationUser user = default!;

    [SupplyParameterFromForm(FormName = "login-with-2fa")]
    private InputModel Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery]
    private bool RememberMe { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();

        // Garante que o usuário passou pela tela de e-mail/senha primeiro
        user = await SignInManager.GetTwoFactorAuthenticationUserAsync() ??
            throw new InvalidOperationException("Não foi possível carregar o usuário de autenticação de dois fatores.");
    }

    private async Task OnValidSubmitAsync()
    {
        var authenticatorCode = Input.TwoFactorCode!.Replace(" ", string.Empty).Replace("-", string.Empty);
        var result = await SignInManager.TwoFactorAuthenticatorSignInAsync(authenticatorCode, RememberMe, Input.RememberMachine);
        var userId = await UserManager.GetUserIdAsync(user);

        if (result.Succeeded)
        {
            Logger.LogInformation("Usuário '{UserId}' fez login com 2FA.", userId);
            RedirectManager.RedirectTo(ReturnUrl);
        }
        else if (result.IsLockedOut)
        {
            Logger.LogWarning("Conta do usuário '{UserId}' foi bloqueada.", userId);
            RedirectManager.RedirectTo("Account/Lockout");
        }
        else
        {
            Logger.LogWarning("Código autenticador inválido para o usuário '{UserId}'.", userId);
            message = "Erro: Código de autenticação inválido.";
        }
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "O código é obrigatório.")]
        [StringLength(7, ErrorMessage = "O {0} deve ter no mínimo {2} e no máximo {1} caracteres.", MinimumLength = 6)]
        [DataType(DataType.Text)]
        [Display(Name = "Código")]
        public string? TwoFactorCode { get; set; }

        [Display(Name = "Lembrar dispositivo")]
        public bool RememberMachine { get; set; }
    }
}