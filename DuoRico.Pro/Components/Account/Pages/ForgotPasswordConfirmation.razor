@page "/Account/ForgotPasswordConfirmation"

@layout DuoRico.Pro.Components.Layout.AuthLayout

<PageTitle>Confirmação - Duo Rico Pro</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8 mb-8">
    <MudPaper Elevation="3" Class="pa-8 rounded-lg text-center" Style="border: 1px solid var(--mud-palette-lines-default);">
        <MudIcon Icon="@Icons.Material.Filled.MarkEmailRead" Color="Color.Primary" Size="Size.Large" Class="mb-4" Style="width: 64px; height: 64px;" />

        <MudText Typo="Typo.h5" Style="font-weight: 700;" Color="Color.Dark" Class="mb-2">Verifique seu e-mail</MudText>

        <MudText Typo="Typo.body1" Color="Color.Dark" Class="mb-6">
            Enviamos um link de recuperação para você. Por favor, verifique sua caixa de entrada (e a pasta de spam) para redefinir sua senha.
        </MudText>

        <MudButton Href="/login" Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true" Style="font-weight: bold;">
            Voltar para o Login
        </MudButton>
    </MudPaper>
</MudContainer>