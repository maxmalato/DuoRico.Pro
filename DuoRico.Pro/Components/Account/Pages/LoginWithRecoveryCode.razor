@page "/Account/LoginWithRecoveryCode"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using DuoRico.Pro.Data

@layout DuoRico.Pro.Components.Layout.AuthLayout

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<LoginWithRecoveryCode> Logger

<PageTitle>Recuperação de Conta - Duo Rico Pro</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8 mb-8">
    <MudPaper Elevation="0" Outlined="true" Class="pa-6 pa-sm-8">

        <div class="d-flex flex-column align-center mb-6">
            <MudIcon Icon="@Icons.Material.Filled.VpnKey" Color="Color.Primary" Size="Size.Large" Class="mb-3" Style="width: 64px; height: 64px;" />
            <MudText Typo="Typo.h5" Color="Color.Dark" Align="Align.Center">Código de Recuperação</MudText>
            <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-2">
                Você solicitou login via código de emergência. Este dispositivo não será lembrado até que você faça login com o aplicativo autenticador novamente.
            </MudText>
        </div>

        <StatusMessage Message="@message" />

        <EditForm Model="Input" FormName="login-with-recovery-code" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator />
            <ValidationSummary class="mud-error-text mb-4" role="alert" />

            <MudTextField @bind-Value="Input.RecoveryCode"
                          For="@(() => Input.RecoveryCode)"
                          name="Input.RecoveryCode"
                          Label="Código de Recuperação"
                          Placeholder="Ex: 1a2b-3c4d"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Class="mb-6" />

            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       Size="Size.Large"
                       Class="mud-width-full py-2"
                      >
                Entrar com Código
            </MudButton>

            <MudButton Href="/"
                       Variant="Variant.Outlined"
                       Color="Color.Dark"
                       Size="Size.Large"
                       Class="mud-width-full py-2 mt-4"
                      >
                Voltar para o login
            </MudButton>
        </EditForm>
    </MudPaper>
</MudContainer>

@code {
    private string? message;
    private ApplicationUser user = default!;

    [SupplyParameterFromForm(FormName = "login-with-recovery-code")]
    private InputModel Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();

        // Garante que o usuário passou pela tela de e-mail/senha primeiro
        user = await SignInManager.GetTwoFactorAuthenticationUserAsync() ??
            throw new InvalidOperationException("Não foi possível carregar o usuário de autenticação de dois fatores.");
    }

    private async Task OnValidSubmitAsync()
    {
        var recoveryCode = Input.RecoveryCode.Replace(" ", string.Empty);

        var result = await SignInManager.TwoFactorRecoveryCodeSignInAsync(recoveryCode);

        var userId = await UserManager.GetUserIdAsync(user);

        if (result.Succeeded)
        {
            Logger.LogInformation("Usuário '{UserId}' fez login com código de recuperação.", userId);
            RedirectManager.RedirectTo(ReturnUrl);
        }
        else if (result.IsLockedOut)
        {
            Logger.LogWarning("Conta do usuário foi bloqueada.");
            RedirectManager.RedirectTo("Account/Lockout");
        }
        else
        {
            Logger.LogWarning("Código de recuperação inválido para o usuário '{UserId}'.", userId);
            message = "Erro: Código de recuperação inválido.";
        }
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "O código de recuperação é obrigatório.")]
        [DataType(DataType.Text)]
        [Display(Name = "Código")]
        public string RecoveryCode { get; set; } = "";
    }
}