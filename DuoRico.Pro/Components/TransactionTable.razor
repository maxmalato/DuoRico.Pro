@using Microsoft.AspNetCore.Identity
@using System.Globalization
@using DuoRico.Pro.Models
@using DuoRico.Pro.Data

@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject ITransactionService TransactionService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudPaper Class="pa-3 pa-sm-4 mt-4" Elevation="3">
    <MudToolBar DisablePadding="true" Class="mb-4">
        <MudText Typo="Typo.h5" Color="Color.Primary" Class="d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.Receipt" Class="mr-2" /> 
            <span class="d-none d-sm-inline">Transações (@Month/@Year)</span>
            <span class="d-inline d-sm-none">@Month/@Year</span>
        </MudText>
        <MudSpacer />
        
        <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.ArrowUpward" OnClick="@(() => OpenNewTransactionDialog(TransactionType.Income))" Class="d-none d-sm-flex mr-2 text-white">
            Receita
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.ArrowDownward" OnClick="@(() => OpenNewTransactionDialog(TransactionType.Expense))" Class="d-none d-sm-flex text-white">
            Despesa
        </MudButton>
        
        <MudIconButton Variant="Variant.Filled" Color="Color.Success" Icon="@Icons.Material.Filled.ArrowUpward" OnClick="@(() => OpenNewTransactionDialog(TransactionType.Income))" Class="d-flex d-sm-none mr-2 text-white" Size="Size.Small" />
        <MudIconButton Variant="Variant.Filled" Color="Color.Error" Icon="@Icons.Material.Filled.ArrowDownward" OnClick="@(() => OpenNewTransactionDialog(TransactionType.Expense))" Class="d-flex d-sm-none text-white" Size="Size.Small" />
    </MudToolBar>
    
    <MudTable Items="@_transactions" 
              Loading="@(_isLoading)" 
              Dense="true" 
              Hover="true" 
              Striped="true" 
              Elevation="0"
              HorizontalScrollbar="true"
              NoItemsText="Nenhuma transação encontrada para este mês.">
        
        <HeaderContent>
            <MudTh>Descrição</MudTh>
            <MudTh Class="d-none d-sm-table-cell">Categoria</MudTh>
            <MudTh>Estado</MudTh>
            <MudTh Style="text-align: right">Valor</MudTh>
        </HeaderContent>
        
        <RowTemplate>
            <MudTd DataLabel="Descrição">
                <MudText Typo="Typo.body2" Style="font-weight: 600">@context.Description</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@context.CreatedAt.ToString("dd/MM/yyyy")</MudText>
            </MudTd>
            <MudTd DataLabel="Categoria" Class="d-none d-sm-table-cell">@context.Category</MudTd>
            <MudTd DataLabel="Estado">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@(context.IsPaid ? Color.Success : Color.Default)">
                    @(context.IsPaid ? "Pago" : "Pend.")
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Valor" Style="text-align: right">
                <MudText Color="@(context.Type == TransactionType.Income ? Color.Success : Color.Error)" Style="font-weight: 700">
                    @context.Amount.ToString("C", CultureInfo.GetCultureInfo("pt-BR"))
                </MudText>
            </MudTd>
        </RowTemplate>
    </MudTable>
</MudPaper>

@code {
    [Parameter] public int Month { get; set; } = DateTime.Now.Month;
    [Parameter] public int Year { get; set; } = DateTime.Now.Year;

    private List<TransactionDto> _transactions = new();
    private bool _isLoading = true;
    private string _currentUserId = string.Empty;
    private Guid _currentCoupleId = Guid.Empty;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            var appUser = await UserManager.GetUserAsync(user);

            if(appUser.Id != null && appUser.CoupleId.HasValue)
            {
                _currentUserId = appUser.Id;
                _currentCoupleId = appUser.CoupleId.Value;
            }
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        if(_currentCoupleId == Guid.Empty) return;
        
        _isLoading = true;

        try
        {
            _transactions = await TransactionService.GetCoupleTransactionsForPeriodAsync(_currentCoupleId, Month, Year);
        }
        finally
        {
            _isLoading = false;
        }
    }
    
    private async Task OpenNewTransactionDialog(TransactionType type)
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        
        var initalModel = new CreateTransactionDto
        { 
            Type = type 
        };

        var parameters = new DialogParameters { ["Model"] = initalModel };

        var dialog = await DialogService.ShowAsync<TransactionDialog>(type == TransactionType.Income ? "Nova Receita" : "Nova Despesa", parameters, options);
        var result = await dialog.Result;

        if (!result!.Canceled && result.Data != null)
        {
            var newTransaction = (CreateTransactionDto)result.Data;

            var success = await TransactionService.CreateTransactionAsync(newTransaction, _currentUserId, _currentCoupleId);

            if (success)
            {
                Snackbar.Add("Transação criada com sucesso!", Severity.Success);
                
                await LoadDataAsync();
                
                StateHasChanged();
            }
            else
            {
                Snackbar.Add("Erro ao criar a transação", Severity.Error);
            }
        }
    }
}